DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
SCENARIO_SECRET_KEY=replace-with-64-hex-characters
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
WEB_ORIGIN=http://localhost:3000
# Optional comma-separated trusted proxy IPs/CIDRs. Leave empty unless requests pass through a trusted ingress.
TRUSTED_PROXY_CIDRS=
# Shared Redis rate-limit namespace; use one stable value across API instances in the same environment.
RATE_LIMIT_PREFIX=nexus:rate-limit
RESEND_API_KEY=
EMAIL_FROM=NEXUS Alerts <alerts@your-domain.com>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
